rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 許可するユーザーのUID(Firebase Authentication のユーザー一覧に表示される)
    function isUs() {
      return request.auth != null
        && request.auth.uid in ['9Oa6h10AcEUe69QHN3520iJRks93', 'nsaJ0BAcO8bHYFZbno30p3EJhQq2'];
    }

    match /messages/{id} {
      allow read, delete: if isUs();
      allow create: if isUs()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.ts == request.time
        && request.resource.data.keys().hasOnly(['v', 'iv', 'ct', 'from', 'ts', 'expireAt']);
      allow update: if false;
    }
    match /events/{id} {
      allow read, write: if isUs();
    }
    // 日ごとの記録: 読めるのはふたり。書き換え・削除は、記録の持ち主(owner)だけ。
    match /days/{id} {
      allow read: if isUs();
      allow create: if isUs()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.keys().hasOnly(['v', 'iv', 'ct', 'owner']);
      allow update: if isUs()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.keys().hasOnly(['v', 'iv', 'ct', 'owner'])
        && (!('owner' in resource.data) || resource.data.owner == request.auth.uid);
      allow delete: if isUs()
        && (!('owner' in resource.data) || resource.data.owner == request.auth.uid);
    }
    // よしよし: 送った本人だけが取り消せる。
    match /pats/{id} {
      allow read: if isUs();
      allow create: if isUs()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.keys().hasOnly(['v', 'iv', 'ct', 'from']);
      allow update: if false;
      allow delete: if isUs() && resource.data.from == request.auth.uid;
    }
    match /shared/{id} {
      allow read, write: if isUs();
    }
    match /profiles/{uid} {
      allow read: if isUs();
      allow write: if isUs() && request.auth.uid == uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
